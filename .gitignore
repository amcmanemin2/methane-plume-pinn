# Reference material (thesis PDF, proposal) — kept locally, not redistributed
files/

# Data — lives on Oak/Scratch, never in git
data/
*.nc
*.h5
*.hdf5
*.npz

# Run outputs: runs/ is committed (copied from $SCRATCH/methane-plume-pinn/runs, including
# checkpoints and Slurm logs); other output locations stay out of git
outputs/
checkpoints/
*.ckpt
*.pt
!runs/**/*.pt
!runs/**/*.npz
wandb/

# Report drafts (kept locally, not in the repository)
reports/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
*.egg-info/
.pytest_cache/

# macOS
.DS_Store

# Local Claude Code settings
.claude/settings.local.json
